rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function nursePath(uid) {
      return /databases/$(database)/documents/nurses/$(uid);
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/demoSessions/$(sessionId);
    }

    function approvedNurse() {
      return signedIn()
        && exists(nursePath(request.auth.uid))
        && get(nursePath(request.auth.uid)).data.approved == true
        && get(nursePath(request.auth.uid)).data.email == request.auth.token.email;
    }

    function sessionMember(sessionId) {
      return approvedNurse()
        && exists(sessionPath(sessionId))
        && request.auth.uid in get(sessionPath(sessionId)).data.participantUids;
    }

    function activeNurse(sessionId) {
      return sessionMember(sessionId)
        && get(sessionPath(sessionId)).data.status == 'ACTIVE'
        && get(sessionPath(sessionId)).data.activeNurseUid == request.auth.uid;
    }

    match /nurses/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || approvedNurse());
      allow list: if approvedNurse();
      allow write: if false; // Provision approved profiles through a trusted administrator.
    }

    match /patients/{patientId} {
      allow read: if approvedNurse();
      allow write: if false;
    }

    match /medicationOrders/{orderId} {
      allow read: if approvedNurse();
      allow write: if false;
    }

    match /demoSessions/{sessionId} {
      allow read: if approvedNurse()
        && request.auth.uid in resource.data.participantUids;
      allow create: if approvedNurse()
        && request.resource.data.sessionId == sessionId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.activeNurseUid == request.auth.uid
        && request.auth.uid in request.resource.data.participantUids
        && request.resource.data.status == 'ACTIVE';
      allow update: if approvedNurse()
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.patientId == resource.data.patientId
        && (
          (activeNurse(sessionId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastSyncAt', 'eventsCount', 'emrTransmitted', 'status', 'endedAt']))
          || (request.auth.uid == resource.data.ownerUid
            && request.auth.uid in request.resource.data.participantUids
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participantUids', 'lastSyncAt'])
            && request.resource.data.participantUids is list
            && request.resource.data.participantUids.size() == resource.data.participantUids.size() + 1
            && request.resource.data.participantUids == resource.data.participantUids.concat([
              request.resource.data.participantUids[resource.data.participantUids.size()]
            ])
            && exists(nursePath(request.resource.data.participantUids[resource.data.participantUids.size()]))
            && get(nursePath(request.resource.data.participantUids[resource.data.participantUids.size()])).data.approved == true)
          || (activeNurse(sessionId)
            && request.resource.data.activeNurseUid in resource.data.participantUids
            && request.resource.data.activeNurseUid != request.auth.uid
            && exists(nursePath(request.resource.data.activeNurseUid))
            && get(nursePath(request.resource.data.activeNurseUid)).data.approved == true
            && request.resource.data.handoffHistory is list
            && request.resource.data.handoffHistory == resource.data.get('handoffHistory', []).concat([{
              'fromUid': request.auth.uid,
              'toUid': request.resource.data.activeNurseUid,
              'at': request.resource.data.lastSyncAt
            }])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['activeNurseUid', 'handoffHistory', 'lastSyncAt']))
        );
      allow delete: if false;
    }

    match /nursingEvents/{eventId} {
      allow read: if sessionMember(resource.data.sessionId);
      allow create: if activeNurse(request.resource.data.sessionId)
        && request.resource.data.eventId == eventId
        && request.resource.data.patientId == get(sessionPath(request.resource.data.sessionId)).data.patientId
        && request.resource.data.nurseUid == request.auth.uid
        && request.resource.data.nurseId == get(nursePath(request.auth.uid)).data.nurseId
        && request.resource.data.eventType is string;
      allow update, delete: if false;
    }

    match /nursingRecords/{recordId} {
      allow read: if sessionMember(resource.data.sessionId);
      allow create: if activeNurse(request.resource.data.sessionId)
        && request.resource.data.id == recordId
        && request.resource.data.nurseUid == request.auth.uid
        && request.resource.data.status == 'DRAFT_PENDING_REVIEW';
      allow update: if activeNurse(resource.data.sessionId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.nurseUid == resource.data.nurseUid
        && (
          (resource.data.status == 'DRAFT_PENDING_REVIEW'
            && request.resource.data.version >= resource.data.version
            && (request.resource.data.status == 'DRAFT_PENDING_REVIEW'
              || (request.resource.data.status == 'APPROVED'
                && request.resource.data.approverUid == request.auth.uid)))
          || (resource.data.status == 'APPROVED'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['emrTransmitted', 'emrTransmittedAt']))
        );
      allow delete: if false;
    }

    match /emrTransfers/{transferId} {
      allow read: if sessionMember(resource.data.sessionId);
      allow create: if activeNurse(request.resource.data.sessionId)
        && request.resource.data.transferId == transferId
        && request.resource.data.nurseUid == request.auth.uid
        && request.resource.data.signatureHash is string
        && request.resource.data.nursingRecordId is string
        && get(/databases/$(database)/documents/nursingRecords/$(request.resource.data.nursingRecordId)).data.status == 'APPROVED'
        && get(/databases/$(database)/documents/nursingRecords/$(request.resource.data.nursingRecordId)).data.sessionId == request.resource.data.sessionId
        && get(/databases/$(database)/documents/nursingRecords/$(request.resource.data.nursingRecordId)).data.patientId == request.resource.data.patientId
        && get(/databases/$(database)/documents/nursingRecords/$(request.resource.data.nursingRecordId)).data.version == request.resource.data.version;
      allow update, delete: if false;
    }
  }
}
